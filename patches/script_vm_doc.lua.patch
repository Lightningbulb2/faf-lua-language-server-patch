--- "lua-language-server-3.18.2/script/vm/doc.lua"
+++ "faf-lua-language-server-patch/script/vm/doc.lua"
@@ -122,6 +122,11 @@
     if valids['Lua 5.1'] then
         valids['LuaJIT'] = true
     end
+    -- FAForever: FA's runtime is Lua 5.0/5.1 based; anything valid for
